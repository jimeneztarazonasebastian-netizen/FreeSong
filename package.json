{
  "name": "freesong",
  "version": "1.0.0",
  "private": true,
  "description": "FreeSong: Reproductor de música web (PWA para iPhone / iOS).",
  "type": "module",
  "scripts": {
    "build": "npm run css",
    "css": "tailwindcss -i src/input.css -o www/app.css --minify",
