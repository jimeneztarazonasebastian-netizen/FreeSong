{
  "name": "freesong",
  "version": "1.0.0",
  "private": true,
  "description": "FreeSong: Reproductor de música web (PWA para iPhone / iOS).",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "npm run css",
    "css": "tailwindcss -i src/input.css -o www/app.css --minify",
    "css:watch": "tailwindcss -i src/input.css -o www/app.css --watch",
    "icons": "node scripts/prepare.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "youtubei.js": "^18.3.0"
  }
}
