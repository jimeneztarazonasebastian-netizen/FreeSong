  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@distube/ytdl-core": "^5.0.1"
  }
}
