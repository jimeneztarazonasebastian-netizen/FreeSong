{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "www",
  "cleanUrls": true,
  "functions": {
    "api/stream.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
