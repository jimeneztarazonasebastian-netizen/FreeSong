{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "www",
  "cleanUrls": true,
  "regions": ["gru1"],
  "functions": {
    "api/health.js": {
      "maxDuration": 60
    },
    "api/stream.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/mixer-start.m3u8",
      "destination": "/api/health?mixer=1&nativeStart=1"
    },
    {
      "source": "/api/relay-info",
      "destination": "/api/health?relay=1"
    }
  ],
  "headers": [
    {
      "source": "/FreeSong.ipa",
      "headers": [{ "key": "Content-Disposition", "value": "attachment; filename=\"FreeSong.ipa\"" }]
    },
    {
      "source": "/mixer-demo/index.m3u8",
      "headers": [{ "key": "Content-Type", "value": "application/vnd.apple.mpegurl" }]
    },
    {
      "source": "/mixer-demo/:segment(segment-[0-9]+\\.ts)",
      "headers": [{ "key": "Content-Type", "value": "video/mp2t" }]
    },
    {
      "source": "/:asset(app\\.min\\.js|util\\.js|storage\\.js|lyrics\\.js|diag\\.js|pwa\\.js|native-audio\\.js|app\\.css)",
      "has": [{ "type": "query", "key": "v", "value": "[0-9]+\\.[0-9]+\\.[0-9]+" }],
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
